rules_version = '2';

// Admin SDK(서버 액션, Genkit 플로우)는 이 규칙을 우회합니다.
// 또한 다운로드 토큰이 포함된 URL은 규칙과 무관하게 동작하므로,
// 앱이 저장해 둔 재생/다운로드 링크는 아래 read 조건과 상관없이 계속 열립니다.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function withinSizeLimit() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // 학생 녹음 파일. 파일명이 평평하게 저장되어 경로로 소유자를 구분할 수 없으므로
    // 목록/직접 조회는 로그인 사용자로 제한합니다.
    match /recordings/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && withinSizeLimit();
    }

    // 평가 문항용 이미지. 업로드한 교사 본인만 씁니다.
    match /assessment-images/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && withinSizeLimit();
    }

    // 도구용 임시 업로드. 예전에는 인증 없이 누구나 쓸 수 있었습니다.
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && withinSizeLimit();
    }

    // 위에서 명시하지 않은 모든 경로는 차단합니다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
