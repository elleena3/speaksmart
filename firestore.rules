rules_version = '2';

// 서버(Genkit 플로우, 서버 액션)는 Admin SDK를 사용하므로 이 규칙을 우회합니다.
// 따라서 여기서는 브라우저에서 들어오는 접근만 고려하면 됩니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn() && myProfile().role == 'teacher';
    }

    // 비밀번호는 Firebase Auth가 보관합니다. 문서에 다시 들어오지 못하게 막습니다.
    function hasNoPassword() {
      return !('password' in request.resource.data);
    }

    match /users/{userId} {
      // 본인 문서, 그리고 교사는 학생 명단 조회를 위해 전체 읽기가 필요합니다.
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());

      // 회원가입은 본인 문서만, 학생 역할로만 만들 수 있습니다.
      // (교사 계정은 seed 스크립트나 콘솔에서만 생성)
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'student'
                    && hasNoPassword();

      // 역할을 스스로 교사로 바꾸는 권한 상승을 차단합니다.
      allow update: if isSignedIn()
                    && (request.auth.uid == userId || isTeacher())
                    && request.resource.data.role == resource.data.role
                    && hasNoPassword();

      allow delete: if isTeacher();
    }

    match /assessments/{assessmentId} {
      // 학생은 배정 여부를 쿼리로 확인하므로 로그인 사용자에게 읽기를 허용합니다.
      allow read: if isSignedIn();

      allow create: if isTeacher() && request.resource.data.uid == request.auth.uid;

      // 응시가 시작된 뒤에는 채점 모델을 바꿀 수 없습니다.
      // 모델마다 채점 성향이 크게 달라(같은 답변이 80점 / 28점) 중간에 바뀌면
      // 같은 평가 안에서 학생마다 다른 기준으로 채점됩니다.
      // 화면에서도 막지만, 저장은 클라이언트 SDK가 직접 하므로 여기서 강제합니다.
      allow update: if isTeacher()
                    && resource.data.uid == request.auth.uid
                    && (
                         resource.data.get('submissionCount', 0) == 0
                         || !request.resource.data.diff(resource.data)
                                .affectedKeys().hasAny(['evaluationModel'])
                       );

      allow delete: if isTeacher() && resource.data.uid == request.auth.uid;
    }

    // 쉐도잉 연습 기록. 본인 것만 쓰고 읽습니다.
    // 같은 문장을 반복하며 점수가 오르는 것을 보기 위한 개인 기록입니다.
    match /shadowingRecords/{recordId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // 한 번 남긴 시도 결과는 고치지 않습니다. 지우는 것만 허용합니다.
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /results/{resultId} {
      // 학생은 본인 결과만, 교사는 본인이 담당한 결과만 볼 수 있습니다.
      // 목록 조회는 쿼리에도 같은 조건이 걸려 있어야 통과합니다.
      allow read: if isSignedIn() && (
                    resource.data.studentId == request.auth.uid
                    || (isTeacher() && resource.data.teacherUid == request.auth.uid)
                  );

      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;

      allow update: if isSignedIn() && (
                      resource.data.studentId == request.auth.uid
                      || (isTeacher() && resource.data.teacherUid == request.auth.uid)
                    );

      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    match /rubrics/{rubricId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.uid == request.auth.uid;
    }

    // 자필 채점 캐시는 서버 액션(Admin SDK)만 사용합니다.
    match /handwriting_gradings/{docId} {
      allow read, write: if false;
    }

    // 위에서 명시하지 않은 모든 경로는 차단합니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
